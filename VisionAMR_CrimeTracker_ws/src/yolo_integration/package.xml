<?xml version="1.0"?>
<package format="3">
  <name>yolo_integration</name>
  <version>0.0.1</version>
  <description>YOLOv8 integration with ROS 2 and Flask web server</description>
  <maintainer email="your.email@example.com">Your Name</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rclpy</build_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>ultralytics</exec_depend>
  <exec_depend>flask</exec_depend>
  <exec_depend>flask_login</exec_depend>
  <exec_depend>psutil</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
